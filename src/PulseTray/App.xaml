<Application x:Class="PulseTray.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="http://www.hardcodet.net/taskbar">
    <Application.Resources>
        <ContextMenu x:Key="TrayMenu">
            <MenuItem Header="Open PulseTray" Click="OpenTrayMenuItem_Click" />
            <Separator />
            <MenuItem Header="Exit" Click="ExitTrayMenuItem_Click" />
        </ContextMenu>
        <tb:TaskbarIcon x:Key="TrayIcon"
                        ToolTipText="PulseTray"
                        ContextMenu="{StaticResource TrayMenu}"
                        TrayMouseDoubleClick="TrayIcon_TrayMouseDoubleClick" />
    </Application.Resources>
</Application>