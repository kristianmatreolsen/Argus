<Window x:Class="Argus.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Argus Settings" Width="340" Height="640"
        Icon="{StaticResource ArgusLogoSource}"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#0F172A" Foreground="#F8FAFC">
    <Window.Resources>
        <Style x:Key="ThresholdBox" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="CaretBrush" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Width" Value="56" />
            <Setter Property="MaxLength" Value="3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,3" />
            <EventSetter Event="LostFocus" Handler="ThresholdTextBox_LostFocus" />
            <EventSetter Event="KeyDown" Handler="ThresholdTextBox_KeyDown" />
        </Style>
        <Style x:Key="SpanOption" TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="GroupName" Value="GraphSpan" />
            <EventSetter Event="Checked" Handler="GraphSpanRadioButton_Checked" />
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Rectangle Width="3" Height="14" Fill="#38BDF8" Margin="0,0,8,0" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Center" />
            <TextBlock Text="DISPLAY SETTINGS" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="DASHBOARD METRICS" Foreground="#64748B" FontSize="10" FontWeight="Bold" Margin="0,0,0,10" />
                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <CheckBox x:Name="GpuTemperatureCheckBox" Content="GPU temperature" Margin="0,0,0,10" />
                        <CheckBox x:Name="GpuLoadCheckBox" Content="GPU load &amp; VRAM" Margin="0,0,0,10" />
                        <CheckBox x:Name="CpuTemperatureCheckBox" Content="CPU temperature" Margin="0,0,0,10" />
                        <CheckBox x:Name="CpuLoadCheckBox" Content="CPU load" Margin="0,0,0,10" />
                        <CheckBox x:Name="MemoryCheckBox" Content="Memory usage" Margin="0,0,0,10" />
                        <CheckBox x:Name="NetworkCheckBox" Content="Network speed" Margin="0,0,0,10" />
                        <CheckBox x:Name="FpsCheckBox" Content="FPS (Frames per second)" Margin="0,0,0,10" />
                        <CheckBox x:Name="FanSpeedCheckBox" Content="Fan speed" Margin="0,0,0,10" />
                        <CheckBox x:Name="SystemCheckBox" Content="System information" Margin="0,0,0,10" />
                        <CheckBox x:Name="DevicesCheckBox" Content="Connected devices" />
                    </StackPanel>
                </Border>

                <TextBlock Text="FAN NAMES" Foreground="#64748B" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBlock Text="Match fans by RPM with Armoury Crate or the BIOS fan monitor. Leave empty to keep the sensor name."
                           Foreground="#64748B" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8" />
                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="NoFansText" Text="No fans are reporting a speed yet." Foreground="#94A3B8" FontSize="11" Visibility="Collapsed" />
                        <ItemsControl x:Name="FanNamesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="130" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DefaultName}" Foreground="#F8FAFC" FontSize="11" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding RpmText}" Foreground="#64748B" FontSize="10" />
                                        </StackPanel>
                                        <TextBox Grid.Column="1" Text="{Binding CustomName, Mode=OneTime}" Tag="{Binding Id}" MaxLength="16"
                                                 Background="#0F172A" Foreground="#F8FAFC" CaretBrush="#F8FAFC" BorderBrush="#334155" Padding="4,3" FontSize="11"
                                                 VerticalContentAlignment="Center" LostFocus="FanNameTextBox_LostFocus" KeyDown="FanNameTextBox_KeyDown" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="GRAPHS &amp; WINDOW" Foreground="#64748B" FontSize="10" FontWeight="Bold" Margin="0,0,0,10" />
                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Graph time span" Foreground="#F8FAFC" FontSize="12" Margin="0,0,0,8" />
                        <StackPanel x:Name="GraphSpanOptions" Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton Style="{StaticResource SpanOption}" Content="30 s" Tag="30" />
                            <RadioButton Style="{StaticResource SpanOption}" Content="2 min" Tag="120" />
                            <RadioButton Style="{StaticResource SpanOption}" Content="5 min" Tag="300" />
                            <RadioButton Style="{StaticResource SpanOption}" Content="10 min" Tag="600" />
                        </StackPanel>
                        <CheckBox x:Name="PinnedOnTopCheckBox" Content="Keep pinned dashboard on top" />
                    </StackPanel>
                </Border>

                <TextBlock Text="TEMPERATURE ALERTS" Foreground="#64748B" FontSize="10" FontWeight="Bold" Margin="0,0,0,10" />
                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="1" Text="Warning" Foreground="#64748B" FontSize="10" FontWeight="Bold" />
                            <TextBlock Grid.Column="2" Text="Critical" Foreground="#64748B" FontSize="10" FontWeight="Bold" />
                            <TextBlock Grid.Row="1" Text="CPU (°C)" Foreground="#F8FAFC" FontSize="12" VerticalAlignment="Center" />
                            <TextBox x:Name="CpuWarningTextBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource ThresholdBox}" />
                            <TextBox x:Name="CpuCriticalTextBox" Grid.Row="1" Grid.Column="2" Style="{StaticResource ThresholdBox}" />
                            <TextBlock Grid.Row="2" Text="GPU (°C)" Foreground="#F8FAFC" FontSize="12" VerticalAlignment="Center" />
                            <TextBox x:Name="GpuWarningTextBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource ThresholdBox}" />
                            <TextBox x:Name="GpuCriticalTextBox" Grid.Row="2" Grid.Column="2" Style="{StaticResource ThresholdBox}" />
                        </Grid>
                        <CheckBox x:Name="TemperatureAlertsCheckBox" Content="Notify when critical for 30 seconds" />
                    </StackPanel>
                </Border>

                <TextBlock Text="TRAY HOVER" Foreground="#64748B" FontSize="10" FontWeight="Bold" Margin="0,0,0,10" />
                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                    <CheckBox x:Name="TrayBatteriesCheckBox" Content="Device battery percentages" />
                </Border>

                <TextBlock Text="WINDOWS STARTUP" Foreground="#64748B" FontSize="10" FontWeight="Bold" Margin="0,0,0,10" />
                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start Argus on Windows startup" />
                        <TextBlock x:Name="StartupHintText" Foreground="#64748B" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Width="84" Height="32" Click="CloseButton_Click" />
            <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="#64748B">
                <Run x:Name="VersionRun" />
                <Run Text="  ·  " />
                <Hyperlink Foreground="#38BDF8" Click="OpenLogFolder_Click">Open log folder</Hyperlink>
            </TextBlock>
        </DockPanel>
    </Grid>
</Window>