<Window x:Class="PulseTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PulseTray" Width="420" Height="480"
        Background="#10161D" Foreground="#F4F7FA"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,24">
            <TextBlock Text="PULSETRAY" FontSize="22" FontWeight="Bold" />
            <TextBlock x:Name="UpdatedText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#91A1AD" />
        </DockPanel>
        <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,24">
            <Border Background="#18232C" Padding="16" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="CPU" Foreground="#91A1AD" /><TextBlock x:Name="CpuText" FontSize="28" FontWeight="SemiBold" /></StackPanel>
            </Border>
            <Border Background="#18232C" Padding="16" Margin="8,0,0,0">
                <StackPanel><TextBlock Text="GPU" Foreground="#91A1AD" /><TextBlock x:Name="GpuText" FontSize="28" FontWeight="SemiBold" /></StackPanel>
            </Border>
        </UniformGrid>
        <StackPanel Grid.Row="2">
            <TextBlock Text="DEVICES" FontWeight="Bold" Foreground="#91A1AD" Margin="0,0,0,10" />
            <ItemsControl x:Name="DeviceList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#18232C" Padding="14" Margin="0,0,0,8">
                            <DockPanel><TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding Status}" DockPanel.Dock="Right" Foreground="#91A1AD" /></DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="EmptyDevicesText" Text="No Windows battery devices reported." Foreground="#91A1AD" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Window>